install: install-regolith-look-nord install-regolith-look-blackhole install-regolith-look-gruvbox install-regolith-look-solarized-dark install-regolith-look-nevil install-regolith-look-dracula install-regolith-look-ayu install-regolith-look-ayu-dark install-regolith-look-ayu-mirage install-regolith-look-i3-default install-regolith-look-lascaille

post-install:
	@if [ -z "$(DESTDIR)" ]; then \
	  glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true; \
	  for d in /usr/share/icons/*/; do [ -f "$$d/index.theme" ] && gtk-update-icon-cache -q -f "$$d" || true; done; \
	  command -v fc-cache >/dev/null && fc-cache -s >/dev/null 2>&1 || true; \
	  update-desktop-database -q /usr/share/applications 2>/dev/null || true; \
	fi

